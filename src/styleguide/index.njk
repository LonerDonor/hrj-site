{# ======================================================================= #}
<section class="sg-section" id="notices">
  <div class="container container--narrow">
    <h2>Notices</h2>
    <p class="sg-intro">Static notices carry their own role; notices updated by JS (form results) use <code>role="status"</code> / <code>role="alert"</code> and are revealed by removing <code>hidden</code>.</p>
    {% set noticeDemo %}
<div class="stack stack--s">
  <div class="notice notice--info" role="note">{% icon "clock" %}<p><strong class="notice__title">Replies within 2–3 working days</strong>WhatsApp is fastest for anything urgent.</p></div>
  <div class="notice notice--success" role="status">{% icon "check" %}<p><strong class="notice__title">Message sent</strong>Thank you — I’ll reply by email.</p></div>
  <div class="notice notice--error" role="alert">{% icon "close" %}<p><strong class="notice__title">That didn’t go through</strong>Please email me directly instead.</p></div>
  <div class="notice">{% icon "pen" %}<p>Neutral notice (no modifier).</p></div>
</div>
    {% endset %}
    {{ noticeDemo | safe }}
    {{ source(noticeDemo) }}
  </div>
</section>

{# ======================================================================= #}
<section class="sg-section section--alt" id="media">
  <div class="container">
    <h2>Media</h2>
    <p class="sg-intro"><code>{{ '{% media src, alt, { ratio, kind, caption, eager, sizes, widths, class, focus } %}' }}</code>. Real files become responsive <code>&lt;picture&gt;</code> (AVIF/WebP/JPEG). Missing files render a decorative placeholder (aria-hidden, no caption). Supported ratios: 1/1, 5/4, 4/3, 3/2, 16/10, 16/9, 2/1, 21/9, 4/5, 3/4, 2/3, 9/16 — others snap to the nearest.</p>
    <div class="grid grid--3">
      {% media "", "", { ratio: "16/9", kind: "photo" } %}
      {% media "", "", { ratio: "1/1", kind: "drawing" } %}
      {% media "", "", { kind: "portrait" } %}
      {% media "", "", { ratio: "3/2", kind: "walk", class: "media--rounded" } %}
      {% media "", "", { ratio: "4/3", kind: "robotics", class: "media--framed" } %}
      {% media "", "", { ratio: "21/9", kind: "map" } %}
    </div>
    {{ source('{% media "/assets/images/work/hiti-research/cover.jpg", "Hiti spout at Mangalbazar", { ratio: "3/2", kind: "heritage", caption: "Mangalbazar, 2023" } %}\n\n→ <figure class="media" data-ratio="3/2"><picture>…</picture><figcaption>Mangalbazar, 2023</figcaption></figure>') }}
  </div>
</section>

{# ======================================================================= #}
<section class="sg-section" id="forms">
  <div class="container container--narrow">
    <h2>Forms</h2>
    <p class="sg-intro">Inputs on <code>--card</code> with a 1.5px <code>--field-border</code>, copper focus ring, brick error state. Required fields show <code>*</code> plus visually-hidden “required”. Errors link via <code>aria-describedby</code> and <code>aria-invalid="true"</code>.</p>
    {% set formDemo %}
<form class="form" action="#forms" method="get" novalidate>
  <div class="form__row">
    <div class="field">
      <label class="field__label" for="sg-name">Full name<span class="field__req" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
      <input id="sg-name" name="name" type="text" autocomplete="name" required>
    </div>
    <div class="field field--error">
      <label class="field__label" for="sg-email">Email<span class="field__req" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
      <input id="sg-email" name="email" type="email" autocomplete="email" required aria-invalid="true" aria-describedby="sg-email-error" value="hrishav@">
      <p class="field__error" id="sg-email-error">{% icon "close" %}Enter an email address like name@example.com</p>
    </div>
  </div>
  <div class="field">
    <label class="field__label" for="sg-topic">What is it about?</label>
    <select id="sg-topic" name="topic">
      {%- for s in services.items %}
      <option value="{{ s.topic }}">{{ s.title }}</option>
      {%- endfor %}
      <option value="other">Something else</option>
    </select>
  </div>
  <div class="field">
    <label class="field__label" for="sg-msg">Message</label>
    <p class="field__hint" id="sg-msg-hint">A few lines on what you need and by when.</p>
    <textarea id="sg-msg" name="message" aria-describedby="sg-msg-hint" placeholder="Tell me about your project…"></textarea>
  </div>
  <div class="field">
    <label class="field__label" for="sg-disabled">Disabled field</label>
    <input id="sg-disabled" type="text" value="Not editable" disabled>
  </div>
  <div class="field field--check">
    <input id="sg-check" type="checkbox" name="consent">
    <label class="field__label" for="sg-check">Keep my details only to reply to this message</label>
  </div>
  <div class="form__actions">
    <button class="btn btn--primary" type="button">Send message{% icon "arrow-right" %}</button>
    <p class="form__note">I usually reply within 2–3 working days.</p>
  </div>
</form>
    {% endset %}
    <div class="sg-frame">{{ formDemo | safe }}</div>
    {{ source(formDemo) }}
  </div>
</section>

{# ======================================================================= #}
<section class="sg-section section--alt" id="faq">
  <div class="container container--narrow">
    <h2>FAQ</h2>
    <p class="sg-intro">Native <code>&lt;details&gt;</code>/<code>&lt;summary&gt;</code> with a custom plus/minus marker. No JS.</p>
    <div class="faq">
      {%- for f in faq | limit(3) %}
      <details class="faq__item"{% if loop.first %} open{% endif %}>
        <summary>{{ f.question }}</summary>
        <div class="faq__answer"><p>{{ f.answer | safe }}</p></div>
      </details>
      {%- endfor %}
    </div>
    {{ source('<div class="faq">\n  <details class="faq__item">\n    <summary>Question?</summary>\n    <div class="faq__answer"><p>Answer.</p></div>\n  </details>\n</div>') }}
  </div>
</section>

{# ======================================================================= #}
<section class="sg-section" id="heroes">
